<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="true" />

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Vehicle SDK: Gear·Odometer(CAR_DRIVE), Door(CAR_DOORS) -->
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <uses-permission android:name="pleos.car.permission.CAR_DOORS" />
    <!-- NaviHelper SDK -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE_SEARCH" />
    <!-- FusedLocation SDK (런타임 허용 필요) -->
    <uses-permission android:name="pleos.car.permission.FUSED_LOCATION" />
    <!-- TextToSpeech / SpeechToText SDK -->
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />
    <uses-permission android:name="pleos.car.permission.STT_SERVICE" />

    <application
        android:name=".screen.WayfitApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.WayfitPleosAndroid">

        <activity
            android:name=".screen.main.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- 주행 중에도 추천 카드를 보여주기 위해 필요 (없으면 AAOS가 주행 중 화면을 차단) -->
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
        </activity>
    </application>

</manifest>
